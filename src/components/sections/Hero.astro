---
import Clover from '../brand/Clover.astro';
import Button from '../ui/Button.astro';
import { HOME, NAV } from '../../data/copy';
---

<section class="hero" aria-labelledby="hero-title" data-section="hero">
  <div class="preloader" aria-hidden="true"></div>
  <div class="hero__inner wrap grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title" data-fx="weight-field" data-inspect="H1 / display">{HOME.hero.title}</h1>
      <p class="hero__sub lede" data-inspect="Lede">{HOME.hero.sub}</p>
      <div class="hero__actions">
        <Button href="/start/" variant="gold" magnetic>{NAV.cta}</Button>
        <Button href="#leaves" variant="line" data-scroll-to="leaves">{HOME.hero.secondary}</Button>
      </div>
    </div>

    <div class="hero__stage">
      <div class="hero__mark" data-voxel-anchor="hero" data-preload-mark data-inspect="Voxel anchor / clover">
        <Clover class="hero__svg" tight solid />
        <button class="hero__poke" type="button" data-ctl="explode" aria-label="Scatter the clover and rebuild it"></button>
      </div>
      <p class="hero__hint" data-gl-only><span class="hint-fine">{HOME.hero.hint}</span><span class="hint-touch">{HOME.hero.hintTouch}</span></p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--nav-h) + var(--s-6)) var(--s-12);
  }

  .hero__inner {
    align-items: center;
    row-gap: var(--s-8);
  }

  .hero__copy {
    grid-column: 1 / span 7;
    position: relative;
  }

  .hero__title {
    font-size: clamp(3rem, 1.2rem + 6.4vw, 7.5rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 600;
    max-width: 9.5em;
    text-wrap: balance;
  }

  .hero__sub {
    margin-top: var(--s-6);
    max-width: 40ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  .hero__stage {
    grid-column: 8 / span 5;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
  }

  .hero__mark {
    position: relative;
    width: min(100%, 34vw, 520px);
    aspect-ratio: 1;
  }

  .hero__svg {
    width: 100%;
    height: 100%;
    transition: opacity var(--d-2) steps(3, jump-end);
  }

  :global(html.gl-ready) .hero__svg {
    opacity: 0;
  }

  .hero__poke {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .hero__poke:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 12px;
  }

  .hero__hint {
    font-size: var(--step--1);
    color: var(--ink-2);
    opacity: 0;
    transition: opacity var(--d-4) var(--ease-out);
  }

  :global(html.gl-ready) .hero__hint {
    opacity: 1;
  }

  .hint-touch {
    display: none;
  }

  @media (pointer: coarse) {
    .hint-fine {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  @media (max-width: 1023px) {
    .hero {
      align-items: flex-start;
    }
    .hero__copy {
      grid-column: 1 / -1;
    }
    .hero__stage {
      grid-column: 1 / -1;
      justify-items: start;
    }
    .hero__mark {
      width: min(100%, 62vw, 420px);
    }
  }
</style>
