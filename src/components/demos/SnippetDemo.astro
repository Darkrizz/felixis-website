---
import { site } from '../../data/site.config.mjs';
const host = new URL(site.url).host;
// Growth demo: a search-result preview that truncates by measured pixel width, not by
// character count, the way result pages do.
---

<div class="snip" data-demo="snippet" data-inspect="Demo / search snippet">
  <div class="snip__fields">
    <label>
      <span>Page title <output class="dots" data-t-out></output></span>
      <input type="text" value="Felixis Web Solutions: websites, brands and web apps built to be found" data-title spellcheck="false" />
    </label>
    <label>
      <span>Description <output class="dots" data-d-out></output></span>
      <textarea rows="2" data-desc spellcheck="false">We plan, design, build and grow websites. Every page is hand-built, quick on a cheap phone and measured after launch, so the work keeps paying for itself.</textarea>
    </label>
  </div>
  <div class="snip__preview" aria-live="polite">
    <p class="snip__url">{host} › services</p>
    <p class="snip__title" data-t-prev></p>
    <p class="snip__desc" data-d-prev></p>
  </div>
</div>

<style>
  .snip {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-3);
    height: 100%;
    align-content: start;
  }

  .snip__fields {
    display: grid;
    gap: 12px;
  }

  .snip__fields label {
    display: grid;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .snip__fields label > span {
    display: flex;
    justify-content: space-between;
  }

  .snip__fields output {
    font-size: 0.9375rem;
    color: var(--leaf);
  }

  .snip__fields output.over {
    color: var(--gold);
  }

  .snip__fields input,
  .snip__fields textarea {
    width: 100%;
    padding: 10px 12px;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.4;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    resize: none;
  }

  .snip__fields input:focus-visible,
  .snip__fields textarea:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* a neutral results-page look: light card, system sans, blue link-like title */
  .snip__preview {
    padding: 14px 16px;
    background: #fbfcfa;
    color: #202124;
    font-family: Arial, Helvetica, sans-serif;
    max-width: 640px;
    min-width: 0;
    overflow: hidden;
  }

  .snip__url {
    font-size: 12px;
    color: #4d5156;
    margin-bottom: 4px;
  }

  .snip__title {
    font-size: 20px;
    line-height: 1.3;
    color: #1a0dab;
    white-space: nowrap;
    overflow: hidden;
  }

  .snip__desc {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.58;
    color: #4d5156;
  }
</style>
