---
// Development demo: a damped spring you can tune; the code and the plot follow the sliders.
---

<div class="spr" data-demo="spring" data-cls-sandbox data-inspect="Demo / spring physics">
  <div class="spr__stage" data-stage>
    <span class="spr__home" aria-hidden="true"></span>
    <button class="spr__cell" type="button" data-cell aria-label="Spring cell. Drag it, or press Enter to flick it."></button>
  </div>
  <div class="spr__side">
    <div class="spr__controls">
      <label><span>Stiffness <output class="dots" data-k-out>170</output></span><input type="range" min="20" max="500" value="170" data-k /></label>
      <label><span>Damping <output class="dots" data-c-out>14</output></span><input type="range" min="1" max="60" value="14" data-c /></label>
      <label><span>Mass <output class="dots" data-m-out>1.0</output></span><input type="range" min="0.3" max="4" step="0.1" value="1" data-m /></label>
    </div>
    <canvas class="spr__plot" aria-hidden="true" data-plot></canvas>
    <p class="spr__read" aria-live="polite" data-read></p>
    <pre class="spr__code" data-code></pre>
  </div>
</div>

<style>
  .spr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-6);
    min-width: 0;
  }

  .spr__stage {
    position: relative;
    min-height: 360px;
    contain: strict;
    background-image: radial-gradient(circle, var(--line-strong) 1px, transparent 1.5px);
    background-size: 24px 24px;
    border: 1px solid var(--line);
    touch-action: none;
  }

  .spr__home {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border: 1px dashed var(--line-strong);
  }

  .spr__cell {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    background: var(--gold);
    cursor: grab;
    will-change: transform;
  }

  .spr__cell:active {
    cursor: grabbing;
  }

  .spr__cell:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .spr__side {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    min-width: 0;
  }

  .spr__controls {
    display: grid;
    gap: var(--s-2);
  }

  .spr__controls label {
    display: grid;
    gap: 4px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .spr__controls span {
    display: flex;
    justify-content: space-between;
  }

  .spr__controls output {
    color: var(--leaf);
    font-size: 1rem;
  }

  .spr__controls input {
    accent-color: var(--leaf);
    height: 22px;
  }

  .spr__plot {
    width: 100%;
    height: 110px;
    background: var(--surface-2);
  }

  .spr__read {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .spr__code {
    margin: 0;
    padding: var(--s-3);
    background: var(--surface-2);
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    color: var(--ink-2);
  }

  .spr__code :global(b) {
    color: var(--gold-text);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .spr {
      grid-template-columns: 1fr;
    }
    .spr__stage {
      min-height: 260px;
    }
  }
</style>
