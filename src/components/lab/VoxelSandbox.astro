---
import Clover from '../brand/Clover.astro';
import PixelIcon from '../ui/PixelIcon.astro';
const BRUSHES = [
  { label: 'Leaf green', hex: '#4CB27A' },
  { label: 'Gold', hex: '#E8B422' },
  { label: 'Paper', hex: '#EEF1EA' },
  { label: 'Coral', hex: '#FF6B5A' },
  { label: 'Sky', hex: '#6FB7FF' },
];
---

<div class="sbx" data-demo="sandbox">
  <div class="sbx__stage" data-sbx-stage>
    <div class="sbx__anchor" data-voxel-anchor="experiment">
      <Clover tight solid class="sbx__svg" />
    </div>
    <p class="sbx__hint" data-sbx-hint>Drag to turn the clover. Pick a colour to paint cubes instead.</p>
    <p class="sbx__fallback">This experiment needs WebGL. The clover above is the SVG version of the same 33 cells.</p>
  </div>
  <div class="sbx__tools" role="toolbar" aria-label="Sandbox tools">
    <button class="sbx__btn nx" data-size="s" type="button" data-sbx="explode"><PixelIcon name="plus" />Explode</button>
    <button class="sbx__btn nx" data-size="s" type="button" data-sbx="gravity" aria-pressed="false"><PixelIcon name="arrow" class="sbx__down" />Gravity</button>
    <fieldset class="sbx__brushes">
      <legend>Paint</legend>
      <label class="sbx__brush"><input type="radio" name="brush" value="" checked /><span class="sbx__none">Off</span></label>
      {
        BRUSHES.map((b) => (
          <label class="sbx__brush">
            <input type="radio" name="brush" value={b.hex} />
            <span style={`background:${b.hex}`}>
              <span class="sr-only">{b.label}</span>
            </span>
          </label>
        ))
      }
    </fieldset>
    <button class="sbx__btn nx" data-size="s" type="button" data-sbx="reset">Reset</button>
  </div>
</div>

<style>
  .sbx {
    display: grid;
    gap: var(--s-3);
  }

  .sbx__stage {
    position: relative;
    min-height: min(72vh, 720px);
    display: grid;
    place-items: center;
    touch-action: none;
    cursor: grab;
    overflow: hidden;
  }

  .sbx__stage:active {
    cursor: grabbing;
  }

  .sbx__stage.is-painting {
    cursor: crosshair;
  }

  .sbx__anchor {
    width: min(58vh, 80%, 520px);
    aspect-ratio: 1;
  }

  .sbx__svg {
    width: 100%;
    height: 100%;
  }

  :global(html.gl-ready) .sbx__svg {
    opacity: 0;
  }

  .sbx__hint {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .sbx__fallback {
    position: absolute;
    left: var(--s-3);
    top: var(--s-3);
    max-width: 40ch;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  :global(html.gl-ready) .sbx__fallback {
    display: none;
  }

  .sbx__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
  }

  .sbx__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 var(--s-3);
    font-weight: 600;
  }

  .sbx__btn[aria-pressed='true'] {
    --nx-fill: var(--ink);
    color: var(--ground);
  }

  .sbx__btn :global(.sbx__down) {
    rotate: 90deg;
  }

  .sbx__brushes {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 var(--s-2);
    padding: 0;
    border: 0;
  }

  .sbx__brushes legend {
    float: left;
    margin-right: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .sbx__brush {
    position: relative;
  }

  .sbx__brush input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .sbx__brush > span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 2px solid transparent;
    outline: 1px solid var(--line-strong);
  }

  .sbx__none {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .sbx__brush input:checked + span {
    border-color: var(--ground);
    outline: 2px solid var(--ink);
  }

  .sbx__brush input:focus-visible + span {
    outline: 3px solid var(--focus);
  }
</style>
