---
// Draw a pixel mark on the same 7x7 grid as the Felixis clover, preview it at icon sizes,
// and download it as an SVG.
import PixelIcon from '../ui/PixelIcon.astro';
const INKS = [
  { id: 'leaf', label: 'Green', hex: '#4CB27A' },
  { id: 'gold', label: 'Gold', hex: '#E8B422' },
  { id: 'paper', label: 'Paper', hex: '#EEF1EA' },
  { id: 'erase', label: 'Eraser', hex: '' },
];
---

<div class="mam" data-demo="mark">
  <div class="mam__editor">
    <div class="mam__grid" role="group" aria-label="7 by 7 pixel grid. Click or drag to paint; arrow keys move, Enter paints." data-grid>
      {
        Array.from({ length: 7 }, (_, r) => (
          <div class="mam__row">
            {Array.from({ length: 7 }, (_, c) => (
              <button type="button" class="mam__px" data-c={c} data-r={r} aria-label={`Row ${r + 1}, column ${c + 1}, empty`} />
            ))}
          </div>
        ))
      }
    </div>
    <div class="mam__side">
      <fieldset class="mam__inks">
        <legend>Ink</legend>
        {
          INKS.map((ink, i) => (
            <label class="mam__ink">
              <input type="radio" name="ink" value={ink.id} checked={i === 0} />
              <span style={ink.hex ? `background:${ink.hex}` : undefined}>{!ink.hex && <PixelIcon name="close" size={12} />}</span>
              {ink.label}
            </label>
          ))
        }
      </fieldset>
      <div class="mam__previews" aria-label="Previews at icon sizes">
        <figure><div class="mam__pv" data-pv="16" style="--s:16px"></div><figcaption>16</figcaption></figure>
        <figure><div class="mam__pv" data-pv="32" style="--s:32px"></div><figcaption>32</figcaption></figure>
        <figure><div class="mam__pv" data-pv="64" style="--s:64px"></div><figcaption>64</figcaption></figure>
        <figure><div class="mam__pv mam__pv--light" data-pv="64l" style="--s:64px"></div><figcaption>on paper</figcaption></figure>
      </div>
      <div class="mam__actions">
        <button class="mam__btn nx" data-size="s" type="button" data-act="download">Download SVG</button>
        <button class="mam__btn nx" data-size="s" type="button" data-act="copy">Copy SVG code</button>
        <button class="mam__link" type="button" data-act="felixis">Load the Felixis mark</button>
        <button class="mam__link" type="button" data-act="clear">Clear</button>
      </div>
      <p class="mam__status" aria-live="polite" data-status></p>
    </div>
  </div>
</div>

<style>
  .mam__editor {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: start;
    padding: var(--s-4);
  }

  .mam__grid {
    display: grid;
    gap: 3px;
    width: min(100%, 520px);
    aspect-ratio: 1;
    touch-action: none;
    user-select: none;
  }

  .mam__row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
  }

  .mam__px {
    background: var(--surface-2);
    border: 1px solid var(--line);
    transition: background-color var(--d-1) steps(2, jump-none);
  }

  .mam__px:hover {
    border-color: var(--ink-2);
  }

  .mam__px:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
    z-index: 1;
  }

  .mam__side {
    display: grid;
    gap: var(--s-6);
  }

  .mam__inks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mam__inks legend {
    width: 100%;
    font-weight: 600;
    margin-bottom: var(--s-2);
  }

  .mam__ink {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px 0 6px;
    border: 1px solid var(--line-strong);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  .mam__ink input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .mam__ink > span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }

  .mam__ink:has(input:checked) {
    border-color: var(--ink);
    background: var(--surface-2);
  }

  .mam__ink:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .mam__previews {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--s-4);
  }

  .mam__previews figure {
    display: grid;
    gap: 6px;
    justify-items: center;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .mam__pv {
    width: var(--s);
    height: var(--s);
    background: #13201a;
  }

  .mam__pv--light {
    background: #eef1ea;
    box-shadow: 0 0 0 1px var(--line);
  }

  .mam__pv :global(svg) {
    width: 100%;
    height: 100%;
  }

  .mam__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }

  .mam__btn {
    min-height: 44px;
    padding: 0 var(--s-3);
    font-weight: 600;
  }

  .mam__link {
    min-height: 44px;
    padding: 0 6px;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .mam__status {
    min-height: 1.6em;
    font-size: 0.9375rem;
    color: var(--leaf);
  }

  @media (max-width: 860px) {
    .mam__editor {
      grid-template-columns: 1fr;
      padding: 0;
    }
  }
</style>
