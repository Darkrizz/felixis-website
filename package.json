{
  "name": "felixis",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4410",
    "prebuild": "node tools/subset-fonts.mjs",
    "build": "astro build && node tools/check-budgets.mjs",
    "preview": "node tools/serve.mjs",
    "check": "astro check",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node tools/test/transitions.mjs && node tools/test/axe.mjs && node tools/test/overflow.mjs",
    "test:lh": "node tools/test/lighthouse.mjs / 3",
    "assets": "node tools/gen-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/doto": "5.3.0",
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@types/three": "0.186.0",
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "subset-font": "2.9.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
